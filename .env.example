# XRP-Pay Router server environment (copy to .env and fill in)
# ALL URLs, addresses, network ids, and the RLUSD issuer come from env vars —
# nothing is hardcoded. Never commit your .env or any wallet/private key.
# Where the server listens
PORT=8080
HOST=0.0.0.0
# XRPL network id for x402 payment requests. "xrpl:1" = testnet, "xrpl:0" = mainnet.
XRPL_NETWORK=xrpl:1
# Address that receives all payments (operator's wallet).
# REQUIRED for real verification — payments land here.
PAYMENT_RECEIVER=
# Per-request payment amount.
#   PAYMENT_ASSET=XRP   -> XRP drops (1 XRP = 1_000_000 drops), e.g. 1000000
#   PAYMENT_ASSET=RLUSD -> RLUSD value, e.g. 0.01
PAYMENT_REWARD_DROPS=1000000
# Which payment facilitator to use: mock | quicknode | t54
#   mock      = default, current zero-config behavior: uses the in-process
#               real verifier when XRPL_RPC_URL is set, otherwise the in-memory
#               mock (local dev, no network)
#   quicknode = real on-ledger XRP/RLUSD verification over XRPL JSON-RPC
#               (requires XRPL_RPC_URL below)
#   t54       = hosted T54 x402 facilitator verify+settle
#               (requires T54_FACILITATOR_URL below)
PAYMENT_FACILITATOR=mock
# Hosted T54 x402 facilitator base URL. Used ONLY when PAYMENT_FACILITATOR=t54.
#   Testnet: https://xrpl-facilitator-testnet.t54.ai
#   Mainnet: https://xrpl-facilitator-mainnet.t54.ai
T54_FACILITATOR_URL=
# Real on-ledger payment verification (used by PAYMENT_FACILITATOR=quicknode):
# an XRPL JSON-RPC endpoint.
# Set to a QuickNode XRPL endpoint, or the public testnet node for dev:
#   https://s.altnet.rippletest.net:51234
# Empty (default) + PAYMENT_FACILITATOR=mock = zero-config local dev, no real funds.
XRPL_RPC_URL=
# Payment asset advertised in challenges: "XRP" (default) or "RLUSD".
# RLUSD also requires RLUSD_ISSUER below.
PAYMENT_ASSET=XRP
# RLUSD token issuer address. Used ONLY when PAYMENT_ASSET=RLUSD.
#   Mainnet issuer (per docs.ripple.com): rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De
#   Testnet issuer:                         rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
# Set the exact address whose RLUSD you accept. Never hardcode it in code.
RLUSD_ISSUER=
# Optional public base URL of this server (logs / errors).
PUBLIC_URL=
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Real LLM provider key (DeepSeek). Empty = stub replies (responses carry stub: true).
LLM_API_KEY=
# DeepSeek API base URL (OpenAI-compatible endpoint).
LLM_BASE_URL=https://api.deepseek.com
# Hard deadline for one LLM provider call, in milliseconds (all providers).
LLM_TIMEOUT_MS=30000

# --- NVIDIA NIM (hosted build.nvidia.com endpoints) ---
# Free developer tier (~40 rpm, no card). Keys look like "nvapi-...".
# NVIDIA publishes NO per-token price for these endpoints and puts production
# use under NVIDIA AI Enterprise, so router-core records these models with an
# unknown cost: they rank last and are skipped when a request sets a cost
# ceiling. Empty = the "nvidia" provider is not callable.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OVHcloud AI Endpoints (verified free/low-cost provider) ---
# With a token: 400 requests/min per Public Cloud project per model (the
# project needs a payment method; Discovery-mode projects cannot use it).
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
OVH_AI_ENDPOINTS_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# Anonymous free tier: no token at all, 2 requests/min per IP per model.
# Opt-in, because 2 rpm is a dev/failover convenience, not a production path.
OVH_AI_ENDPOINTS_ALLOW_ANONYMOUS=false

# --- Routing (router-core; runs after payment verification) ---
# Which strategy picks the model:
#   cheapest (default) -> cheapest model matching capabilities + cost ceiling
#   tiered             -> classify the prompt, then cheapest model that meets
#                         the tier's capability requirements
ROUTING_STRATEGY=cheapest
# Route only to providers this server can actually call (adapter + API key).
# false (default) keeps today's behavior: unconfigured providers answer with the stub.
ROUTING_SKIP_UNCONFIGURED_PROVIDERS=false
# How many models of the fallback chain one request may try after a retryable
# provider failure (LLM_BUSY / LLM_TIMEOUT / LLM_PROVIDER_ERROR).
ROUTING_MAX_ATTEMPTS=2

# --- Usage metering (OpenMeter) ---
# OpenMeter records USAGE only. Payment, routing and pricing stay in Sonpay:
# no price, fee or payment amount is ever sent to OpenMeter.
# Both OPENMETER_URL and OPENMETER_API_KEY must be set or metering stays off
# (the server still answers and still prices requests).
#
# Kong Konnect Metering & Billing: this is the REGIONAL KONNECT API host, e.g.
#   https://us.api.konghq.com   https://eu.api.konghq.com
#   https://au.api.konghq.com   https://in.api.konghq.com
# A serverless gateway proxy hostname (kong-xxxx.kongcloud.dev) is NOT the
# ingest endpoint — it answers "no Route matched with those values".
# Self-hosted OpenMeter: your own host, with OPENMETER_EVENTS_PATH=/api/v1/events
# and OPENMETER_CUSTOMERS_PATH=/api/v1/customers.
OPENMETER_URL=https://in.api.konghq.com
# Konnect personal/system account token ("kpat_..." / "spat_...") or an
# OpenMeter API key. RUNTIME ONLY — never commit it.
OPENMETER_API_KEY=
# Ingest path appended to OPENMETER_URL.
OPENMETER_EVENTS_PATH=/v3/openmeter/events
# Customer path appended to OPENMETER_URL. OpenMeter only counts an event
# against a customer when some customer claims its subject; without the
# mapping the event is stored but reports
#   "no customer found for event subject: ..."
# and never reaches a bill.
OPENMETER_CUSTOMERS_PATH=/v3/openmeter/customers
# Register the VERIFIED PAYER as an OpenMeter customer before reporting its
# usage (key = subject = payer address, so the upsert is idempotent).
# Set to false if you manage customers by hand in the Konnect UI — the server
# then never writes to your customer list.
OPENMETER_AUTO_CREATE_CUSTOMERS=true
# CloudEvents `source` stamped on every event (also namespaces the event id,
# which is what deduplicates a replayed payment).
OPENMETER_SOURCE=sonpay
# Hard deadline for one ingest call, ms. A slow meter must never hold up an
# answer the caller already paid for.
OPENMETER_TIMEOUT_MS=5000

# --- Platform fee ---
# Markup on the provider's cost, in basis points. 500 = 5%.
#   customer price = provider cost x (1 + PLATFORM_MARKUP_BPS/10000)
#   platform fee   = customer price - provider cost
# Applied only to models whose provider publishes BOTH a prompt and a
# completion rate; anything else is metered but reported as unpriced.
PLATFORM_MARKUP_BPS=500

# --- Console (web frontend) ---
# How many recent requests the read-only console endpoints (/v1/activity,
# /v1/payments) keep in memory. It is a rolling window for the dashboard, not
# a billing record — OpenMeter holds the durable one — and it is cleared when
# the server restarts.
ACTIVITY_RETENTION=500
# Directory of built console assets to serve from the gateway itself, e.g.
# "packages/web/dist" after `npm run build`. Empty (the default) serves the
# API only, which is what you want when Vite is serving the console in dev.
WEB_DIST=
# Dev only, read by packages/web/vite.config.ts: where the Vite dev server
# proxies /v1 and /healthz. Defaults to http://127.0.0.1:8080.
VITE_API_TARGET=http://127.0.0.1:8080
