# XRP-Pay Router server environment (copy to .env and fill in)
# ALL URLs, addresses, and network ids come from env vars — nothing is hardcoded.

# Where the server listens
PORT=8080
HOST=0.0.0.0

# t54 hosted XRPL facilitator (real wiring TODO). Empty = mock facilitator.
XRPL_FACILITATOR_URL=

# XRPL network id for x402 payment requests. "xrpl:1" = testnet, "xrpl:0" = mainnet.
XRPL_NETWORK=xrpl:1

# Address that collects payments. REQUIRED before the real facilitator is wired.
PAYMENT_RECEIVER=

# Per-request payment in XRP drops (1 XRP = 1_000_000 drops).
PAYMENT_REWARD_DROPS=1000000

# Optional public base URL of this server (logs / errors).
PUBLIC_URL=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Real LLM provider key (TODO: used by model-stub once wired).
LLM_API_KEY=